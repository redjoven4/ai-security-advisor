# Copy this file to ".env" and fill in your own values.
# .env is ignored by git, so nothing in it is ever uploaded.

# Which AI engine V1 uses:
#   ollama = free small model running on this computer (needs the Ollama app)
#   claude = Anthropic's Claude API (needs an API key and credits)
AI_PROVIDER=ollama

# --- Local model (AI_PROVIDER=ollama) ---
# Default is qwen2.5vl:7b (reads text AND screenshots).
# Smaller, text-only alternative: qwen2.5:3b (screenshot reading won't work)
# OLLAMA_MODEL=qwen2.5vl:7b
# OLLAMA_URL=http://127.0.0.1:11434

# --- Claude (AI_PROVIDER=claude) ---
# Your key from https://platform.claude.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# --- Server ---
# PORT=8080

# Optional: set when you connect your own database (see server/db.mjs)
# DATABASE_URL=
