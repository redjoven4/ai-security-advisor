# Copy this file to ".env" and fill in your own values.
# .env is ignored by git, so your key is never uploaded.

# Required: your Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional settings
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# PORT=8080

# Optional: set when you connect your own database (see server/db.js)
# DATABASE_URL=
